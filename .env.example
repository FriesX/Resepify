# RESEPIFY ENVIRONMENT CONFIGURATION
# Salin berkas ini ke .env.local untuk menghubungkan proyek ke Supabase

# URL dan Anon Key Proyek Supabase Anda
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Email Admin Utama (Otomatis dijadikan Admin saat login via Google/Email)
NEXT_PUBLIC_ADMIN_EMAILS=edgarchuang343@gmail.com

# Mode Aplikasi (Bila Supabase tidak diisi, Resepify otomatis berjalan dalam mode Local Persistent Mock)
NEXT_PUBLIC_APP_NAME=Resepify
NEXT_PUBLIC_APP_URL=http://localhost:3000
